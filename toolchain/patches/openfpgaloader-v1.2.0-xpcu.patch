+static bool xilinx_firmware_running(libusb_device_handle *handle)
+{
+	uint8_t constant[2] = {0, 0};
+	uint8_t version[2] = {0, 0};
+	int rc = libusb_control_transfer(handle, 0xc0, 0xb0,
+		0x40, 0, constant, 2, 1000);
+	int rv = libusb_control_transfer(handle, 0xc0, 0xb0,
+		0x50, 0, version, 2, 1000);
+	return rc == 2 && constant[0] == 0xb5 && constant[1] == 0x03
+		&& rv == 2 && (version[0] != 0 || version[1] != 0);
+}
